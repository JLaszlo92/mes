{
  "name": "mes-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Next-generation MES — monorepo (shared types, edge agent, backend, frontend).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "dev:backend": "pnpm --filter @mes/backend dev",
    "dev:edge-agent": "pnpm --filter @mes/edge-agent dev",
    "dev:frontend": "pnpm --filter @mes/frontend dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
