# Board: ESP32-S3 module with 16 MB flash and 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Boot without PSRAM if a board variant has none: the buffer limit is then taken from internal RAM.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Wired only: Bluetooth off; Wi-Fi is never started (and not linked: nothing requires esp_wifi).
CONFIG_BT_ENABLED=n

# Ethernet: W5500 over SPI.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# 1 kHz tick: the input sampler and the agent loop work in milliseconds.
CONFIG_FREERTOS_HZ=1000

# A hung task reboots the box (the buffer is on flash, nothing is lost but the last second).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_INT_WDT=y

# TLS: TLS 1.2 with ECDSA P-256 (the MES CAs use prime256v1); IP and DNS names in subjectAltName are checked.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_ESP_TLS_USING_MBEDTLS=y

# MQTT: larger buffers for the claim answer and long event lines.
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=60000

# HTTP client: https only.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# LittleFS for the event buffer.
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_SPIFFS_COMPAT=n
CONFIG_LITTLEFS_USE_MTIME=n
CONFIG_LITTLEFS_FLUSH_FILE_EVERY_WRITE=n

# Console on the USB port (USB-Serial/JTAG of the ESP32-S3).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Stacks: the main task only starts things (the agent runs in its own 16 KB task); the event loop task logs network
# events. Canary bytes on the function stacks (STACK_CHECK) and a watchpoint at the end of every task stack turn a
# stack overflow into a clear panic message instead of a jump into data (io-node-v1 crashed that way).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
