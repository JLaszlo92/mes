# /etc/mes/backup.env — root-only (0600). Titkot NEM tartalmaz: az AWS kulcs
# a /root/.aws/credentials fájlban van (aws configure --profile mes-backup).
S3_BUCKET=your-bucket-name
AWS_PROFILE=mes-backup
AWS_REGION=eu-central-1
# Opcionális:
# DB_NAME=mes
# LOCAL_DIR=/var/backups/mes
# LOCAL_KEEP=3
# S3-kompatibilis, nem AWS tár (pl. helyi MinIO) esetén:
# S3_ENDPOINT_URL=https://minio.example.local:9000
